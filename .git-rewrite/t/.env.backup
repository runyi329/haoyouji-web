# 好友记生产环境配置文件
# 请根据实际情况修改以下配置

# 数据库连接 (本地MySQL)
DATABASE_URL=mysql://haoyouji:haoyouji123@localhost:3306/haoyouji_dev

# JWT密钥 (用于用户会话加密,请使用随机生成的密钥)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node环境
NODE_ENV=production

# 服务器端口
PORT=3009

# 可选: DeepSeek API密钥 (如果需要AI功能)
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Manus存储API配置 (用于头像上传)
BUILT_IN_FORGE_API_URL=https://api.manus.im/api/forge
BUILT_IN_FORGE_API_KEY=${OPENAI_API_KEY}

# 可选: 分析统计
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
