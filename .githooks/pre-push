#!/bin/sh
# ============================================================
# 脉动网项目推送拦截 Hook
# 规则：必须由用户在对话中明确授权后，才能执行 git push
# 授权方式：用户说"可以推送"后，沙箱执行 touch .push-authorized
# ============================================================

if [ ! -f ".push-authorized" ]; then
  echo ""
  echo "❌ =================================================="
  echo "❌  推送被拦截：未获得用户授权"
  echo "❌ =================================================="
  echo ""
  echo "   本项目严禁沙箱自行推送代码到 main 分支。"
  echo "   请先将预览链接发给用户确认效果，"
  echo "   等待用户明确说「可以推送」后，"
  echo "   再执行：touch .push-authorized"
  echo "   然后重新执行 git push。"
  echo ""
  exit 1
fi

echo "✅ 推送授权已确认，正在推送..."
