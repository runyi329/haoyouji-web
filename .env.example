# 数据库连接配置
# 格式: mysql://username:password@host:port/database
DATABASE_URL=mysql://username:password@gateway03.us-east-1.prod.aws.tidbcloud.com:4000/dWfvfUieyVkmVGc44bjad7

# S3存储配置(可选,用于备份上传)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=haoyouji-backups
S3_REGION=us-east-1

# AI助手配置
DEEPSEEK_API_KEY=your_deepseek_api_key

# 企查查API配置
QICHACHA_APP_KEY=your_qichacha_app_key
QICHACHA_SECRET_KEY=your_qichacha_secret_key

# 充值配置
RECHARGE_WALLET_ADDRESS_TRC20=TTHZ7NvpKSMCyU3JNLLN6zZNruysy5emQJ
RECHARGE_MIN_AMOUNT=1
RECHARGE_ORDER_EXPIRE_MINUTES=30

# 米伴物流：授权参数仅配置在服务端，切勿设置VITE_前缀或写入前端。
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
# 先完成固定回调地址部署及签名验证，再启用；沙箱预览保持false。
KUAIDI100_SUBSCRIPTION_ENABLED=false
KUAIDI100_CALLBACK_URL=
# 可选：使用部署目录之外的持久数据目录；默认 ~/.local/share/haoyouji/miban-logistics
MIBAN_LOGISTICS_CACHE_DIR=
